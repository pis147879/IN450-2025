Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Prova", " ", "con", " ", "solo", " ", "6", " ", "nibble", " ", "della", " ",
     "chiave", " ", "incogniti"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"E1", "[", 
      RowBox[{"P_", ",", " ", "roundkeys_"}], "]"}], ":=", 
     RowBox[{"Encryption", "[", 
      RowBox[{"P", ",", " ", 
       RowBox[{"roundkeys", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "3"}], "]"}], "]"}], ",", " ", 
       RowBox[{"constants", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", "3"}], "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"D1", "[", 
      RowBox[{"C_", ",", " ", "roundkeys_"}], "]"}], ":=", 
     RowBox[{"Decryption", "[", 
      RowBox[{"C", ",", " ", 
       RowBox[{"roundkeys", "[", 
        RowBox[{"[", 
         RowBox[{"4", ";;", "6"}], "]"}], "]"}], ",", " ", 
       RowBox[{"constants", "[", 
        RowBox[{"[", 
         RowBox[{"4", ";;", "6"}], "]"}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"CandKeys", "[", 
      RowBox[{"p_", ",", "c_", ",", "k_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rk", ",", "e1", ",", "e2"}], "}"}], ",", 
       "\[IndentingNewLine]", "\t\t\t\t", 
       RowBox[{
        RowBox[{"rk", "=", 
         RowBox[{"GenKey", "[", "k", "]"}]}], ";", "\[IndentingNewLine]", 
        "\t\t\t\t", 
        RowBox[{"e1", "=", 
         RowBox[{"E1", "[", 
          RowBox[{"p", ",", "rk"}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\t\t\t\t", 
        RowBox[{"e2", "=", 
         RowBox[{"D1", "[", 
          RowBox[{"c", ",", "rk"}], "]"}]}], ";", " ", "\[IndentingNewLine]", 
        "\t\t\t\t", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"e1", "==", "e2"}], ",", " ", "k"}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p", "=", 
     RowBox[{"RandomInteger", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "15"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"c", "=", 
