Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ricerca", " ", "esaustiva", " ", "tra", " ", "le", " ", "chiavi", " ", 
    "candidate"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"pos", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"keys", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Impongo", " ", "alcuni", " ", "nibble", " ", "della", " ", "chiave", " ",
      "per", " ", "diminuire", " ", "il", " ", "costo", " ", 
     "computazionale"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"keys", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"ReplacePart", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", "#", "]"}], ",", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"11", ",", "14", ",", "15"}], "}"}], "->", 
              RowBox[{"{", 
               RowBox[{"1", ",", "12", ",", "12"}], "}"}]}], "]"}]}], "]"}], ",",
           "4"}], "]"}], "&"}], ",", "keys"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", 
     RowBox[{"Complement", "[", 
      RowBox[{"pos", ",", 
       RowBox[{"{", 
        RowBox[{"11", ",", "14", ",", "15"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"comb", "=", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "15"}], "]"}], ",", 
       RowBox[{"Length", "[", "pos", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tempo2", ",", "keyfind"}], "}"}], "=", 
