Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ricerca", " ", "esaustiva", " ", "tra", " ", "le", " ", "chiavi", " ", 
    "candidate"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"codebook", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"P", "=", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "15"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"Encryption", "[", 
          RowBox[{"P", ",", 
           RowBox[{"GenKey", "[", "key", "]"}], ",", "constants"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "100"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KeyVerify", "[", "k_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"rk", "=", 
         RowBox[{"GenKey", "[", 
          RowBox[{"Partition", "[", 
           RowBox[{"k", ",", "4"}], "]"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", "\t\t\t\t\t", 
       RowBox[{"AllTrue", "[", 
        RowBox[{"codebook", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Encryption", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", "rk", ",", "constants"}], 
            "]"}], "==", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "&"}]}], "]"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"BruteForce", "[", 
      RowBox[{"k0_", ",", "pos_", ",", "comb_"}], "]"}], ":=", 
     RowBox[{"Catch", "[", 
      RowBox[{
       RowBox[{"Scan", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"key", "=", 
               RowBox[{"ReplacePart", "[", 
                RowBox[{"k0", ",", 
                 RowBox[{"Thread", "[", 
                  RowBox[{"pos", "->", "#"}], "]"}]}], "]"}]}], "}"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"KeyVerify", "[", "key", "]"}], ",", 
               RowBox[{"Throw", "[", "key", "]"}]}], "]"}]}], "]"}], ")"}], 
          "&"}], ",", "comb"}], "]"}], ";", "Null"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Position", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"keys", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Impongo", " ", "alcuni", " ", "nibble", " ", "della", " ", "chiave", " ",
      "per", " ", "diminuire", " ", "il", " ", "costo", " ", 
     "computazionale"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"keys", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Partition", "[", 
         RowBox[{
          RowBox[{"ReplacePart", "[", 
           RowBox[{
            RowBox[{"Flatten", "[", "#", "]"}], ",", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"11", ",", "14", ",", "15"}], "}"}], "->", 
              RowBox[{"{", 
               RowBox[{"1", ",", "12", ",", "12"}], "}"}]}], "]"}]}], "]"}], ",",
           "4"}], "]"}], "&"}], ",", "keys"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pos", "=", 
     RowBox[{"Complement", "[", 
      RowBox[{"pos", ",", 
       RowBox[{"{", 
        RowBox[{"11", ",", "14", ",", "15"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"comb", "=", 
     RowBox[{"Tuples", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", "15"}], "]"}], ",", 
       RowBox[{"Length", "[", "pos", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tempo2", ",", "keyfind"}], "}"}], "=", 
     RowBox[{"AbsoluteTiming", "[", 
      RowBox[{"Catch", "[", 
       RowBox[{"Scan", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"ck", "=", 
               RowBox[{"BruteForce", "[", 
                RowBox[{
                 RowBox[{"Flatten", "[", "#", "]"}], ",", "pos", ",", 
                 "comb"}], "]"}]}], "}"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"ck", "=!=", "Null"}], ",", 
               RowBox[{"Throw", "[", 
                RowBox[{"Partition", "[", 
                 RowBox[{"ck", ",", "4"}], "]"}], "]"}]}], "]"}]}], "]"}], 
           ")"}], "&"}], ",", "keys"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<La chiave trovata dall'attacco \[EGrave]: \>\"", ",", 
     "keyfind"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"keyfind", "==", "key"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
