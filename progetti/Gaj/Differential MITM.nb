            RowBox[{
             RowBox[{"{", 
              RowBox[{"ck", "=", 
               RowBox[{"BruteForce", "[", 
                RowBox[{
                 RowBox[{"Flatten", "[", "#", "]"}], ",", "pos", ",", 
                 "comb"}], "]"}]}], "}"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"ck", "=!=", "Null"}], ",", 
               RowBox[{"Throw", "[", 
                RowBox[{"Partition", "[", 
                 RowBox[{"ck", ",", "4"}], "]"}], "]"}]}], "]"}]}], "]"}], 
           ")"}], "&"}], ",", "keys"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
